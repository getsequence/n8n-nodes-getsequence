{
  "name": "n8n-nodes-getsequence",
  "version": "0.1.1",
  "description": "n8n community node for the Sequence Platform v1 API (accounts, transfers, rules, transactions)",
  "license": "MIT",
  "homepage": "https://github.com/getsequence/n8n-nodes-getsequence",
  "keywords": [
    "n8n-community-node-package",
    "sequence",
    "getsequence",
    "banking",
    "fintech"
  ],
  "author": { "name": "Sequence", "email": "engineering@getsequence.io" },
  "repository": {
    "type": "git",
    "url": "https://github.com/getsequence/n8n-nodes-getsequence.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node build"
  },
  "files": ["dist", "!dist/tsconfig.tsbuildinfo"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": ["dist/credentials/SequenceApi.credentials.js"],
    "nodes": ["dist/nodes/Sequence/Sequence.node.js"]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.29.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": { "n8n-workflow": "*" }
}
